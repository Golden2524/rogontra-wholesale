# API server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5500

# Database (added with the PostgreSQL milestone)
DATABASE_URL=postgresql://username:password@localhost:5432/rogontra_wholesale

# Authentication (generate a unique random value; never commit the real secret)
JWT_SECRET=replace-with-a-long-random-secret

# Administrator bootstrap (register this email first, then run npm run admin:grant)
ADMIN_EMAIL=admin@example.com

# Payments (test values only; live secrets belong in the deployment dashboard)
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
