{
  "name": "rogontra-wholesale",
  "version": "0.1.0",
  "private": true,
  "description": "Global B2B wholesale and industrial equipment marketplace.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "api:start": "node --env-file-if-exists=.env.local backend/src/server.js",
    "api:dev": "node --env-file-if-exists=.env.local --watch backend/src/server.js",
    "storefront:start": "node --env-file-if-exists=.env.local backend/scripts/serve-storefront.js",
    "db:migrate": "node --env-file-if-exists=.env.local backend/scripts/migrate.js",
    "db:status": "node --env-file-if-exists=.env.local backend/scripts/status.js",
    "db:seed": "node --env-file-if-exists=.env.local backend/scripts/seed-catalogue.js",
    "db:catalogue-status": "node --env-file-if-exists=.env.local backend/scripts/catalogue-status.js",
    "db:verify-persistence": "node --env-file-if-exists=.env.local backend/scripts/verify-persistence.js",
    "db:verify-auth": "node --env-file-if-exists=.env.local backend/scripts/verify-auth.js",
    "db:verify-account-history": "node --env-file-if-exists=.env.local backend/scripts/verify-account-history.js",
    "admin:grant": "node --env-file-if-exists=.env.local backend/scripts/grant-admin.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  }
}
